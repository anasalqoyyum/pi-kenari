{
  "name": "pi-kenari",
  "version": "0.1.0",
  "description": "Kenari model provider for Pi, with live model discovery and KENARI_API_KEY authentication",
  "type": "module",
  "keywords": ["pi-package", "kenari", "pi-provider"],
  "files": ["index.ts", "src", "README.md"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
